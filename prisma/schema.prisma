generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id Int @id @default(autoincrement())

  email        String @unique
  password     String
  role         Role   @default(USER)
  referralCode String @unique
  referredBy   String

  referral         Referral[]
  request          SoftRequests[]
  withdrawRequests WithdrawRequest[]
  review           Review[]

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt
}

model Item {
  id          Int         @id @default(autoincrement())
  name        String
  price       String
  photo       String
  description String?
  categoryId  Int?
  category    Category?   @relation(fields: [categoryId], references: [id])
  type        Type[]
  licenseType LicenseType @default(PERPETUAL)

  characteristics Characteristic[]
  distributives   Distributive[]
  questions       QuestionAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Characteristic {
  id     Int    @id @default(autoincrement())
  title  String
  value  String
  itemId Int
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Distributive {
  id          Int    @id @default(autoincrement())
  displayName String
  fileUrl     String
  itemId      Int
  item        Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuestionAnswer {
  id       Int    @id @default(autoincrement())
  itemId   Int
  item     Item   @relation(fields: [itemId], references: [id])
  question String
  answer   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id Int @id @default(autoincrement())

  text  String
  photo String
  grade Int

  userId Int?  @unique
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt
}

model Category {
  id Int @id @default(autoincrement())

  photo       String
  title       String @unique
  description String
  items       Item[]

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt
}

model Referral {
  id Int @id @default(autoincrement())

  totalReferrals Int   @default(0)
  percent        Int   @default(0)
  totalCashback  Float @default(0)

  userId Int?  @unique
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt
}

model Orders {
  id Int @id @default(autoincrement())

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt
}

model SoftRequests {
  id Int @id @default(autoincrement())

  userId Int?  @unique
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt
}

model Article {
  id Int @id @default(autoincrement())

  title String
  text  String
  photo String

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt
}

enum Type {
  KEY
  SUBSCRIPTION
  ACCOUNT
}

enum LicenseType {
  PERPETUAL
  ONE_MONTH
  THREE_MONTHS
  SIX_MONTHS
  ONE_YEAR
}

model WithdrawRequest {
  id Int @id @default(autoincrement())

  phone Int
  bank  String
  name  String
  sum   String

  userEmail String?
  user      User?   @relation(fields: [userEmail], references: [email], onDelete: Cascade)

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
}
