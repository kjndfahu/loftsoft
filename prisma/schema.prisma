generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int               @id @default(autoincrement())
  email            String            @unique
  password         String
  role             Role              @default(USER)
  referralCode     String            @unique
  referredById     Int?              @map("referredBy")
  referredBy       User?             @relation("Referral", fields: [referredById], references: [id])
  referrals        User[]            @relation("Referral")
  request          SoftRequests[]
  withdrawRequests WithdrawRequest[]
  review           Review[]
  orders           Order[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  Referral         Referral?
}

model Item {
  id              Int              @id @default(autoincrement())
  name            String
  price           String
  newPrice        String?
  photo           String
  description     String?
  categoryId      Int?
  purchasedCount  Int              @default(0)
  category        Category?        @relation(fields: [categoryId], references: [id])
  type            Type[]
  licenseType     String[]         @default([])
  deviceCounts    Int[]            @default([])
  characteristics Characteristic[]
  distributives   Distributive[]
  questions       QuestionAnswer[]
  popularProducts PopularProduct[]
  articles        Article[]
  reviews         Review[]
  relatedProducts Item[]           @relation("RelatedProducts")
  relatedBy       Item[]           @relation("RelatedProducts")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  orderItems      OrderItem[] // Relation to OrderItem model
  autorelease     Boolean          @default(false) // New field with default false
}

model Characteristic {
  id     Int    @id @default(autoincrement())
  title  String
  value  String
  itemId Int
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Distributive {
  id          Int    @id @default(autoincrement())
  displayName String
  fileUrl     String
  itemId      Int
  item        Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuestionAnswer {
  id       Int    @id @default(autoincrement())
  itemId   Int
  item     Item   @relation(fields: [itemId], references: [id])
  question String
  answer   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Article {
  id Int @id @default(autoincrement())

  title   String
  text    String  @db.Text
  photo   String
  slug    String? @unique
  excerpt String? @db.Text

  relatedProducts Item[]
  relatedArticles Article[] @relation("RelatedArticles")
  relatedTo       Article[] @relation("RelatedArticles")

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt
}

model Review {
  id        Int      @id @default(autoincrement())
  text      String
  photo     String
  grade     Int
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    Int
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade) // Relation to Item
  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt
}

model KnowledgeBaseCategory {
  id        Int                    @id @default(autoincrement())
  name      String
  emoji     String                 @default("📄")
  order     Int                    @default(0)
  articles  KnowledgeBaseArticle[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
}

model KnowledgeBaseArticle {
  id         Int                   @id @default(autoincrement())
  title      String
  content    String                @db.Text
  emoji      String?               @default("")
  order      Int                   @default(0)
  categoryId Int
  category   KnowledgeBaseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
}

model Category {
  id Int @id @default(autoincrement())

  photo       String
  title       String @unique
  description String
  items       Item[]

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt
}

model Referral {
  id Int @id @default(autoincrement())

  totalReferrals Int   @default(0)
  percent        Int   @default(0)
  totalCashback  Float @default(0)

  userId Int?  @unique
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt
}

model Order {
  id            Int         @id @default(autoincrement())
  userId        Int?
  user          User?       @relation(fields: [userId], references: [id])
  email         String? // Note: In createOrder, email is required, but schema allows null for flexibility
  totalAmount   Float
  status        String      @default("PENDING")
  adminResponse String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orderItems    OrderItem[] // Relation to OrderItem model
  text          String? // New optional field
}

model OrderItem {
  id          Int    @id @default(autoincrement())
  orderId     Int
  order       Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId      Int
  item        Item   @relation(fields: [itemId], references: [id], onDelete: Restrict)
  type        String
  quantity    Int
  price       Float // Price at the time of the order
  oldPrice    Float? // Old price at the time of the order, if applicable
  licenseType String // Add licenseType field
  deviceCount Int // Add deviceCount field
}

model SoftRequests {
  id Int @id @default(autoincrement())

  name    String
  email   String
  program String
  comment String?
  status  RequestStatus @default(PENDING)

  userId Int?  @unique
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt
}

model PopularProduct {
  id        Int      @id @default(autoincrement())
  itemId    Int
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Type {
  KEY
  SUBSCRIPTION
  ACCOUNT
}

model WithdrawRequest {
  id Int @id @default(autoincrement())

  phone Int
  bank  String
  name  String
  sum   String

  userEmail String?
  user      User?   @relation(fields: [userEmail], references: [email], onDelete: Cascade)

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
}

enum RequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
}
